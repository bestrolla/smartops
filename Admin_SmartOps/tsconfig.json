{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",  // Cambiado de "bippy/dist" a "react"

    /* Linting */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,     // Añadir esto
    "forceConsistentCasingInFileNames": true  // Añadir esto
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules"]  // Añadir esto
}